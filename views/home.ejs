      <span class="craft-chip"><i class="fa-solid fa-brush me-1"></i> Blue Pottery &middot; Rajasthan</span>
      <span class="craft-chip"><i class="fa-solid fa-brush me-1"></i> Banarasi Weaves &middot; Uttar Pradesh</span>
    </div> -->
    </div>
  </section>


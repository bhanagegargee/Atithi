<% layout('/layouts/boilerplate') %>
<body>
<div class="landing">

  <!-- ============================== HERO ============================== -->
  <section class="landing-hero" style="background-image: url('/images/haveli-shekhawati-west.jpg');">
    <div class="landing-hero-content">
      <span class="hero-slogan"><i class="fa-solid fa-om"></i> Atithi Devo Bhava &middot; अतिथि देवो भव:</span>
      <h1>Stay in India. <em>Experience</em> India. Discover India.</h1>
      <p>From painted havelis in the desert to backwater houseboats in the south — Atithi is where you stay inside India's living culture, not just next to it.</p>
      <div class="hero-cta-row">
        <a href="/listings" class="btn btn-atithi-primary"><i class="fa-solid fa-compass me-1"></i> Explore Stays</a>
        <a href="/listings/new" class="btn btn-hero-ghost"><i class="fa-solid fa-house-flag me-1"></i> Host Your Home</a>
      </div>
    </div>
  </section>

  <!-- ====================== ONE COUNTRY, MANY WORLDS ==================== -->
  <section class="landing-section">
    <div class="section-head">
      <span class="eyebrow">Regions of India</span>
      <h2>One country, a thousand journeys</h2>
      <p>Every region of India stays, celebrates and builds differently. Atithi is built around that difference, not around one postcard version of India.</p>
    </div>

    <div class="region-grid">
      <div class="region-card" style="background-image: url('/images/kerala-homestay-south.jpg');">
        <div class="region-card-body">
          <span class="region-tag">South India</span>
          <h3>Kerala, Tamil Nadu &amp; the Deccan</h3>
          <p>Backwater homestays, temple towns and centuries-old performing arts.</p>
        </div>
      </div>

      <div class="region-card" style="background-image: url('/images/haveli-interior-west.jpg');">
        <div class="region-card-body">
          <span class="region-tag">West India</span>
          <h3>Rajasthan, Gujarat &amp; the Konkan</h3>
          <p>Painted havelis, desert forts and a coastline of fishing villages.</p>
        </div>
      </div>

      <div class="region-card" style="background-image: url('/images/holi-festival-north.jpg');">
        <div class="region-card-body">
          <span class="region-tag">North India</span>
          <h3>Uttar Pradesh, Punjab &amp; the Himalayas</h3>
          <p>Colour-drenched festivals, mountain valleys and Mughal-era heritage.</p>
        </div>
      </div>

      <div class="region-card" style="background-image: url('/images/madhubani-peacock-east.jpg');">
        <div class="region-card-body">
          <span class="region-tag">East India</span>
          <h3>Bihar, West Bengal &amp; Odisha</h3>
          <p>Folk art traditions, river deltas and ancient temple architecture.</p>
        </div>
      </div>

      <!-- <div class="region-card no-photo">
        <div class="region-card-body">
          <i class="fa-solid fa-mountain-sun"></i>
          <span class="region-tag">Northeast India</span>
          <h3>Assam, Meghalaya &amp; the Hill States</h3>
          <p>Living root bridges, tea gardens and a patchwork of tribal cultures.</p>
        </div>
      </div> -->
    </div>
  </section>

  <!-- ============================== QUOTE =============================== -->
  <section class="landing-section text-center" style="padding-top: 0;">
    <p style="font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.3rem; max-width: 700px; margin: 0 auto; color: var(--text-secondary);">
      "अतिथि देवो भव:" &mdash; the guest is akin to God. It's the oldest idea in Indian hospitality,
      and it's the only idea Atithi is really built on.
    </p>
  </section>

  <!-- ============================ CRAFTS & TEXTILES ====================== -->
  <section class="landing-section is-tinted">
    <div style="padding: 0.5rem 1.5rem;">
     <div class="section-head">
      <span class="eyebrow">Celebrations &amp; Performing Arts</span>
      <h2>Festivals and dance that never stopped</h2>
      <p>Living traditions, still performed and still celebrated the way they always have been.</p>
    </div>

    <div class="gallery-grid">
      <div class="strip-card">
        <img src="/images/holi-festival-north.jpg" alt="Holi festival celebrations" loading="lazy">
        <div class="strip-caption">
          <span class="region-tag">North India</span>
          <strong>Holi, the festival of colour</strong>
        </div>
      </div>

      <div class="strip-card">
        <img src="/images/bharatanatyam-1-south.jpg" alt="Bharatanatyam classical dancer" loading="lazy">
        <div class="strip-caption">
          <span class="region-tag">South India</span>
          <strong>Bharatanatyam, Tamil Nadu</strong>
        </div>
      </div>

      <div class="strip-card">
        <img src="/images/kathakali-south.jpg" alt="Kathakali performer, Kerala" loading="lazy">
        <div class="strip-caption">
          <span class="region-tag">South India</span>
          <strong>Kathakali, Kerala</strong>
        </div>
      </div>

      <div class="strip-card">
        <img src="/images/bharatanatyam-2-south.jpg" alt="Classical dancer at a temple" loading="lazy">
        <div class="strip-caption">
          <span class="region-tag">South India</span>
          <strong>Temple dance traditions</strong>
        </div>
      </div>
    </div>

    <!-- <div class="chip-row">
      <span class="craft-chip"><i class="fa-solid fa-brush me-1"></i> Madhubani &middot; Bihar</span>
      <span class="craft-chip"><i class="fa-solid fa-brush me-1"></i> Warli &middot; Maharashtra</span>

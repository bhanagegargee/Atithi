  <!-- ============================== FOOD ================================ -->
  <section class="landing-section ">
    <div style="padding: 0.5rem 1.5rem;">
    <div class="section-head">
      <span class="eyebrow">Food &amp; Thalis</span>
      <h2>Flavors from every kitchen</h2>
      <p>No single "Indian food" exists — every region sets its own thali.</p>
    </div>

    <div class="food-grid">
      <div class="food-card">
        <img src="/images/thali-gujarati-west.jpg" alt="Gujarati thali" loading="lazy">
        <div class="food-card-body">
          <p class="food-card-region">West India</p>
          <p class="food-card-title">Gujarati Thali</p>
        </div>
      </div>

      <div class="food-card">
        <img src="/images/thali-rajasthani-west.jpg" alt="Rajasthani thali" loading="lazy">
        <div class="food-card-body">
          <p class="food-card-region">West India</p>
          <p class="food-card-title">Rajasthani Thali</p>
        </div>
      </div>

      <div class="food-card">
        <img src="/images/sadya-kerala-south.jpg" alt="Kerala Sadya on banana leaf" loading="lazy">
        <div class="food-card-body">
          <p class="food-card-region">South India</p>
          <p class="food-card-title">Onam Sadya, Kerala</p>
        </div>
      </div>

      <div class="food-card">
        <img src="/images/thali-banana-leaf-south.jpg" alt="South Indian vegetarian feast" loading="lazy">
        <div class="food-card-body">
          <p class="food-card-region">South India</p>
          <p class="food-card-title">Banana-Leaf Feast</p>
        </div>
      </div>

    
    </div>
    </div>
  </section>

  <!-- ======================= TRADITIONAL STAYS ========================== -->
  <section class="landing-section">
    <div class="section-head center" style="max-width: 700px;">
      <span class="eyebrow">Where You'll Sleep</span>
      <h2>Traditional stays, reimagined</h2>
    
      </div>

    <div class="stay-feature">
      <div class="stay-feature-img">
        <img src="/images/haveli-interior-west.jpg" alt="Heritage haveli interior, Western India" loading="lazy">
      </div>
      <div class="stay-feature-text">
        <span class="eyebrow">West India</span>
        <h3>Havelis with centuries behind them</h3>
        <p>Carved wooden pillars, courtyard light and hand-painted ceilings — heritage havelis across Rajasthan and Gujarat, opened up as stays instead of museums.</p>
       <% for(let state of states ) { %>
        <% if(state=='Rajasthan') { %>
        <a href="/listings/state/<%= encodeURIComponent(state) %>" class="btn btn-atithi-outline">Browse heritage stays</a>
        <% } %>
        <% } %>
      </div>
    </div>

    <div class="stay-feature reverse">
      <div class="stay-feature-img">
        <img src="/images/kerala-homestay-south.jpg" alt="Traditional Kerala homestay" loading="lazy">
      </div>
      <div class="stay-feature-text">
        <span class="eyebrow">South India</span>
        <h3>Nalukettu homes of Kerala</h3>
        <p>Sloped tiled roofs, an open central courtyard, and a garden that runs straight into the coconut groves — the traditional homestead of the Malabar coast.</p>
         <% for(let state of states ) { %>
        <% if(state=='Kerala') { %>
        <a href="/listings/state/<%= encodeURIComponent(state) %>" class="btn btn-atithi-outline">Browse Kerala stays</a>
        <% } %>
        <% } %>
      </div>
    </div>

    <div class="stay-feature">
      <div class="stay-feature-img">
        <img src="/images/houseboat-kerala-south.jpg" alt="Kerala backwaters houseboat" loading="lazy">
      </div>
      <div class="stay-feature-text">
        <span class="eyebrow">South India</span>
        <h3>Houseboats on the backwaters</h3>
        <p>Drift down Alleppey's waterways on a converted rice barge, coconut palms sliding past on both banks — a night's stay unlike anywhere else in the world.</p>
         <% for(let state of states ) { %>
        <% if(state=='Goa') { %>
        <a href="/listings/state/<%= encodeURIComponent(state) %>" class="btn btn-atithi-outline">Browse houseboats</a>
          <% } %>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ================================ CTA =============================== -->
  <section class="cta-band">
    <h2>Your stay in India starts here</h2>
    <p>Havelis, homestays, houseboats and hill retreats — hosted by the people who actually live there.</p>
    <div class="hero-cta-row justify-content-center">
      <a href="/listings" class="btn btn-cta-light"><i class="fa-solid fa-compass me-1"></i> Explore All Stays</a>
      <a href="/listings/new" class="btn btn-hero-ghost"><i class="fa-solid fa-house-flag me-1"></i> List Your Home</a>
    </div>
  </section>

</div>
</body>
</html>

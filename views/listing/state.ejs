<% layout('/layouts/boilerplate') %>
<body>

<div class="state-page-header">
  <h2 class="fw-bold mb-1">Explore <%= state %></h2>
  <p class="text-muted">Stays and experiences in <%= state %>.</p>
</div>

<% if (listings.length === 0) { %>
  <div class="empty-container">
    <h4>No listings found in <%= state %> yet.</h4>
    <a href="/listings/states" class="btn edit-btn mt-2">Explore other states</a>
  </div>
<% } else { %>
  <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of listings) { %>

      <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col" >
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listings-img" style="height : 20rem">
        <div class="card-body">
          <p class="card-text"><b><%= listing.title %></b><br>
          <% if (listing.price != null) { %>
             &#8377; <%= listing.price.toLocaleString("en-IN") %>
            <% } else { %>
             Price not available
            <% } %>
        </div>
      </div>
      </a>

   <% } %>
  </div>
<% } %>

</body>
</html>
